# The host's nginx in front of the stack. Copy to
# /etc/nginx/sites-available/<domain>, symlink into sites-enabled, then let
# certbot add the TLS block: certbot --nginx -d <domain>
#
# The stack publishes 127.0.0.1:8080 and terminates nothing itself.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;

    # Photographs of a maintenance request; the default of 1m refuses them.
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # The application writes this into the audit log and throttles
        # sign-in by it, so it must be the client and not the proxy.
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}
