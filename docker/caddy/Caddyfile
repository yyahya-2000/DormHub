{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Overwrite rather than append: the application trusts this header for the
	# client address it writes into the audit log and throttles sign-in by, and
	# an appended chain starts with whatever the client sent.
	reverse_proxy web:80 {
		header_up X-Forwarded-For {remote_host}
	}
}
