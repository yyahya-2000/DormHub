APP_NAME="Dormitory System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17. Host and port match the service names in docker-compose.yml;
# use DB_HOST=127.0.0.1 when running artisan from the host instead of a container.
# This role owns the schema and runs the migrations.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dormitory
DB_USERNAME=dormitory
DB_PASSWORD=secret

# The role the running application connects as. UPDATE and DELETE on audit_logs
# are revoked from it by migration, so it must differ from DB_USERNAME above,
# which is the role the migrations run under. Created by
# docker/postgres/initdb/10-application-role.sh.
DB_APPLICATION_ROLE=app_rw

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage, served locally by MinIO.
AWS_ACCESS_KEY_ID=dormitory
AWS_SECRET_ACCESS_KEY=dormitory-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dormitory
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Sign-in regime and audit log. Defaults mirror backend/config/dormitory.php.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_TOKEN_TTL_MINUTES=720
AUTH_IDENTITY_PROVIDER="App\Identity\DatabaseIdentityProvider"
AUDIT_PAGE_SIZE=50

VITE_APP_NAME="${APP_NAME}"
