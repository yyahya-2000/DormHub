# Template for the server's .env, which sits next to docker-compose.prod.yml,
# is written by hand once and is not in the repository.
# Compose refuses to start if any value below is left empty.

# The name the host's nginx serves; the certificate is issued for it there.
APP_DOMAIN=dormhub.example.ru

# The loopback port the host's nginx proxies to. Change it if 8080 is taken.
WEB_PORT=8080

# php artisan key:generate --show
APP_KEY=

POSTGRES_DB=dormitory
POSTGRES_USER=dormitory
POSTGRES_PASSWORD=
APP_DB_ROLE=app_rw
APP_DB_PASSWORD=

MINIO_ROOT_USER=dormitory
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=dormitory
